{
  "name": "nestedcanvas",
  "version": "1.0.0",
  "description": "High-performance Nested Infinite Canvas Engine & Interactive Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "sync": "node server/sync_server.js",
    "ai": "python server/ai_vision_server.py",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync android",
    "build:apk": "./build_apk.sh",
    "build:apk:lan": "node scripts/build-apk-lan.mjs",
    "serve:lan": "vite preview --host 0.0.0.0 --port 3200 --strictPort",
    "pc:display": "electron electron/main.cjs",
    "clean:cache": "rm -f server/data/sync_state.json"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "electron": "^44.3.0",
    "lucide": "^1.16.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.2",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.3.289",
    "ws": "^8.21.3"
  }
}
